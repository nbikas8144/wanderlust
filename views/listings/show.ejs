<%- layout("/layout/boilerplate.ejs") %>
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Show</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <div class="row">
    <div class="col-7">
    <h3>Details : </h3>
    </div>

    <div class="card col-6 show-card">
        <div class="card" style="width: 18rem;">
  <img src="<%= listing.image %>" class="card-img-top show-img" alt="Listing...Image">
  <div class="card-body">
    <p class="card-text">
        <i>@<%= listing.owner %></i> <br>
        <b><%= listing.title %> </b> <br>
        <%= listing.description %> <br>
        &#8377; <%= listing.price.toLocaleString("en-IN") %>  <br>
        <%= listing.location %> 
        </p>
  </div>
</div>
    </div>
       </div>
        <br>
    <div class="btns">
        <a href="/listings/<%= listing._id %>/edit"><button class="btn btn-dark edit-btn">Edit List</button></a>
        <br><br>
    
        <form method="post" action="/listings/<%= listing._id %>?_method=DELETE">
            <button class="btn btn-dark offset-3">Delete</button>
        </form>
    </div>
<hr>

<!--Review Section-->
    <div class="col-8  mb-3">
        <h4>Put Your Feedback</h4>
        <form method="post" action="/listings/<%= listing._id %>/reviews" novalidate class="needs-validation">
            <div class="mb-3 mt-3">
                <label for="rating" class="form-label" >Rating</label>
                <input type="range" min="1" max="5" id="ratng" name="review[rating]" class="form-range">
            </div>
            <div class="mb-3 mt-3">
                <label for="comment">Comment</label>
                <textarea name="review[comment]" id="comment" cols="30" rows="10" class="form-control" required></textarea>
                <div class="invalid-feedback">Invalid Comment
                </div>
                <div class="valid-feedback">Good Comment
                </div>
            </div>
            <button class="btn btn-outline-dark mb-3">Submit</button>
        </form>

        <hr>

        <h4>All Reviews</h4>
        <ul>
        <% for(review of listing.reviews){ %>
        <li><%= review.comment %> , <%= review.Rating %> star</li>
        
       <% } %>
        </ul>

        <p><b>All Reviews</b></p>

        <div class="row ">
                <% for(review of listing.reviews){ %>
        
        <div class="listing-card col-5 mb-3 ms-3">
            <div class="card-body">
                <h5 class="card-item">Jane Deo</h5>
                <p class="card-text"><%= review.comment %></p>
                <p class="card-text"><%= review.rating %></p>
                
            </div>

            <form class="mb-3" method="post" action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE">
            <button class="btn del-btn  btn-sm btn-dark">Delete</button>
        </form>

        </div>
        
       <% } %>
       </div>
    </div>
     
</body> 
</html>

